diff --git a/backend/DEPLOY.md b/backend/DEPLOY.md
index 7091efa..710830f 100644
--- a/backend/DEPLOY.md
+++ b/backend/DEPLOY.md
@@ -26,7 +26,10 @@ As tabelas são criadas pelo Flyway na primeira subida; não rode SQL à mão.
    - as três do banco (acima);
    - `GEMINI_API_KEY` e `CLOUDINARY_URL`;
    - `ADMIN_EMAIL` e `ADMIN_PASSWORD` (mínimo 12 caracteres): o ADMIN é criado na primeira subida;
-   - `CORS_ALLOWED_ORIGINS`: a URL do frontend no Vercel.
+   - `CORS_ALLOWED_ORIGINS`: a URL do frontend no Vercel;
+   - `MQTT_BROKER_URL`, `MQTT_USUARIO` e `MQTT_SENHA`: o broker na nuvem que recebe as
+     leituras do ESP32 (ex.: `ssl://xxxxxxxx.ala.us-east-1.emqxsl.com:8883`). Passo a passo em
+     `mqtt/topics.md`. Vazio desliga as leituras de vibração.
 3. Aguarde o deploy e confira `https://<servico>.onrender.com/actuator/health` → `{"status":"UP"}`.
 
 Já vem configurado no `render.yaml`: cookie de sessão `Secure`, cadastro público desligado
@@ -52,6 +55,7 @@ mesma origem. No projeto do frontend, um `vercel.json` com:
 ## Observações
 
 - **Plano gratuito do Render:** o serviço hiberna após ~15 min sem uso; a primeira requisição
-  depois disso demora cerca de 1 minuto.
+  depois disso demora cerca de 1 minuto. A conexão MQTT não o mantém acordado: enquanto
+  ele dorme, as leituras de vibração publicadas no broker se perdem.
 - **Limiar do alerta:** `ALERTA_LIMIAR_NIVEL_ALTO` (padrão `0.6`). Ver `ImageAnalysisPrompt`.
 - **Limite de upload:** `UPLOAD_MAX_FILE_SIZE` (padrão `10MB`).
diff --git a/backend/src/main/java/br/com/railsense_backend/mqtt/VibracaoMqttListener.java b/backend/src/main/java/br/com/railsense_backend/mqtt/VibracaoMqttListener.java
index ba93597..15e8b81 100644
--- a/backend/src/main/java/br/com/railsense_backend/mqtt/VibracaoMqttListener.java
+++ b/backend/src/main/java/br/com/railsense_backend/mqtt/VibracaoMqttListener.java
@@ -21,7 +21,8 @@ import jakarta.annotation.PreDestroy;
 
 /**
  * Assina railsense/sensor/vibracao e grava cada leitura no eixo do sensor.
- * Só existe quando app.mqtt.broker-url está definido (o deploy no Render não tem broker).
+ * Só existe quando app.mqtt.broker-url está definido. Aceita tcp:// (broker local) e
+ * ssl:// (broker na nuvem, certificado conferido pela JVM).
  * A conexão é refeita pelo agendamento abaixo, inclusive se o broker subir depois do backend.
  */
 @Component
diff --git a/backend/src/main/resources/application.yml b/backend/src/main/resources/application.yml
index 4ed8050..22b66f7 100644
--- a/backend/src/main/resources/application.yml
+++ b/backend/src/main/resources/application.yml
@@ -73,7 +73,8 @@ app:
     api-key: ${GEMINI_API_KEY}
     model: ${GEMINI_MODEL:gemini-3.8-flash}
   mqtt:
-    # Vazio desliga a assinatura (ex.: Render, sem broker). No compose: tcp://broker:1883.
+    # Vazio desliga a assinatura. No compose: tcp://broker:1883.
+    # Broker na nuvem (EMQX Cloud): ssl://<endereco>.emqxsl.com:8883 com MQTT_USUARIO e MQTT_SENHA.
     broker-url: ${MQTT_BROKER_URL:}
     topico-vibracao: ${MQTT_TOPICO_VIBRACAO:railsense/sensor/vibracao}
     usuario: ${MQTT_USUARIO:}
diff --git a/camera/.env.example b/camera/.env.example
index 07e94d5..5993cfb 100644
--- a/camera/.env.example
+++ b/camera/.env.example
@@ -22,3 +22,8 @@ INTERVALO_SEGUNDOS=30
 MQTT_BROKER=localhost
 MQTT_PORT=1883
 # Use o mesmo valor de MQTT_HOST_PORT do .env da raiz (ex.: 1884).
+# Broker na nuvem (EMQX Cloud Serverless): endereço do deployment, porta 8883 (liga o TLS) e usuário/senha.
+# MQTT_BROKER=xxxxxxxx.ala.us-east-1.emqxsl.com
+# MQTT_PORT=8883
+MQTT_USUARIO=
+MQTT_SENHA=
diff --git a/camera/camera_bridge.py b/camera/camera_bridge.py
index c4a9294..cdff3f2 100644
--- a/camera/camera_bridge.py
+++ b/camera/camera_bridge.py
@@ -48,6 +48,9 @@ INTERVALO = float(os.environ.get("INTERVALO_SEGUNDOS", "30"))   # 0 desliga o en
 
 MQTT_BROKER = os.environ.get("MQTT_BROKER", "")                 # vazio desliga o MQTT
 MQTT_PORT = int(os.environ.get("MQTT_PORT", "1883"))
+MQTT_USUARIO = os.environ.get("MQTT_USUARIO", "")                # vazio conecta sem login
+MQTT_SENHA = os.environ.get("MQTT_SENHA", "")
+MQTT_TLS = os.environ.get("MQTT_TLS", "1" if MQTT_PORT == 8883 else "0").lower() in ("1", "true", "sim")
 TOPICO_COMANDO = "railsense/camera/capturar"
 TOPICO_IMAGEM = "railsense/camera/imagem"
 
@@ -186,6 +189,10 @@ def iniciar_mqtt():
     mqtt_client = mqtt.Client(mqtt.CallbackAPIVersion.VERSION2)
     mqtt_client.on_connect = ao_conectar
     mqtt_client.on_message = ao_receber
+    if MQTT_TLS:
+        mqtt_client.tls_set()  # confere o certificado do broker com os certificados do sistema
+    if MQTT_USUARIO:
+        mqtt_client.username_pw_set(MQTT_USUARIO, MQTT_SENHA)
     mqtt_client.connect_async(MQTT_BROKER, MQTT_PORT)
     mqtt_client.loop_start()
 
