# PostgreSQL
POSTGRES_DB=railsense_db
POSTGRES_USER=admin
POSTGRES_PASSWORD=change_me

# APIs externas
GEMINI_API_KEY=change_me
GEMINI_MODEL=gemini-3.8-flash
CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name

# Usuário admin criado automaticamente na inicialização
ADMIN_EMAIL=admin@railsense.com
ADMIN_PASSWORD=change_me_min_12_chars
ADMIN_NAME=Administrador RailSense

# Segurança / sessão
CORS_ALLOWED_ORIGINS=http://localhost:5173
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAME_SITE=strict

# Cadastro público (/api/auth/register). O frontend não oferece mais "Criar conta": usuários são criados pela TI.
REGISTRATION_ENABLED=false

# Leituras dos sensores (MQTT). No docker-compose o backend usa tcp://broker:1883.
# Fora do Docker, cuidado: um Mosquitto instalado no Windows também escuta em localhost:1883.
MQTT_ENABLED=true
MQTT_URL=tcp://localhost:1883
