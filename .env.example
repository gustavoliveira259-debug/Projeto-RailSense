# Copie para .env e preencha com valores reais. Nunca versione o .env.
POSTGRES_DB=railsense
POSTGRES_USER=railsense_app
POSTGRES_PASSWORD=troque-por-uma-senha-longa-e-aleatoria

# Criado somente se o e-mail ainda não existir. Use senha de 12+ caracteres.
ADMIN_EMAIL=admin@exemplo.com
ADMIN_PASSWORD=troque-por-uma-senha-longa-e-aleatoria
ADMIN_NAME=Administrador RailSense

# Necessário apenas para desenvolvimento fora do proxy nginx.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Em produção com HTTPS, altere obrigatoriamente para true.
SESSION_COOKIE_SECURE=false
