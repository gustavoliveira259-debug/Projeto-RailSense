# PostgreSQL
POSTGRES_DB=railsense_db
POSTGRES_USER=admin
POSTGRES_PASSWORD=change_me

# APIs externas
GEMINI_API_KEY=change_me
GEMINI_MODEL=gemini-3.8-flash
CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name

# Usuário admin criado automaticamente na inicialização
ADMIN_EMAIL=admin@railsense.com
ADMIN_PASSWORD=change_me_min_12_chars
ADMIN_NAME=Administrador RailSense

# Segurança / sessão
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAME_SITE=strict

# Cadastro público (/api/auth/register). Em produção use false: usuários são criados pelo ADMIN.
REGISTRATION_ENABLED=true

# Porta do broker MQTT no PC. Use 1884 se ja houver um Mosquitto do Windows ocupando a 1883
# (o ESP32 e o camera/.env precisam usar a mesma porta).
MQTT_HOST_PORT=1883
