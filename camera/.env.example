# Copie para camera/.env (não versionado) ou exporte as variáveis antes de rodar.

# Endereço da foto atual servida pelo app de câmera IP no celular.
# IP Webcam (Android): http://<ip-do-celular>:8080/shot.jpg
CAMERA_URL=http://192.168.0.50:8080/shot.jpg
# Preencha se o app pedir usuário/senha.
CAMERA_USER=
CAMERA_PASSWORD=

# Backend RailSense e usuário usado para enviar as imagens.
# Precisa ser ENGENHEIRO: o ADMIN só gerencia contas e recebe 403 em /api/imagens.
# Crie a conta pelo ADMIN (POST /api/usuarios com "papel": "ENGENHEIRO").
BACKEND_URL=http://localhost:8080
BACKEND_EMAIL=camera@exemplo.com
BACKEND_PASSWORD=troque-pela-senha
EIXO_ID=1

# Segundos entre envios automáticos (0 = só envia quando o ESP32 pedir).
INTERVALO_SEGUNDOS=30

# Broker MQTT para receber pedidos do ESP32 (vazio = desliga).
MQTT_BROKER=localhost
MQTT_PORT=1883
# Use o mesmo valor de MQTT_HOST_PORT do .env da raiz (ex.: 1884).
